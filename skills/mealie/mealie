#!/usr/bin/env bash
# Thin auth-adding curl wrapper for the Mealie API.
# Reads MEALIE_BASE_URL and MEALIE_API_KEY from
# ~/.config/mealie/credentials (or accepts them from the environment).

set -euo pipefail

CRED="${MEALIE_CRED_FILE:-$HOME/.config/mealie/credentials}"
if [[ -z "${MEALIE_BASE_URL:-}" || -z "${MEALIE_API_KEY:-}" ]]; then
  if [[ -r "$CRED" ]]; then
    # shellcheck disable=SC1090
    . "$CRED"
  fi
fi
: "${MEALIE_BASE_URL:?missing — set in $CRED or env}"
: "${MEALIE_API_KEY:?missing — set in $CRED or env}"

CURL_OPTS=()
if [[ -n "${MEALIE_CA_BUNDLE:-}" ]]; then
  CURL_OPTS+=(--cacert "$MEALIE_CA_BUNDLE")
elif [[ "${MEALIE_INSECURE:-0}" == "1" ]]; then
  CURL_OPTS+=(-k)
fi

usage() {
  cat <<'EOF'
Usage: mealie <method> <path> [body-json]
       mealie raw <method> <path> [body-json]      # raw body, no jq

Read:
  mealie self
  mealie recipes [search] [page] [perPage]         # list / search recipes
  mealie recipe <slug>                              # full recipe detail
  mealie suggestions [foodId,foodId,...] [limit]    # what can I cook
  mealie mealplans [start_date] [end_date]          # default: today only
  mealie shopping-lists
  mealie shopping-list <listId>                     # items in a list
  mealie cookbooks
  mealie foods [search] [perPage]
  mealie units [search] [perPage]
  mealie categories
  mealie tags

Write:
  mealie scrape-url <url>                           # scrape + create recipe
  mealie mealplan-add <date> <entryType> <recipeId> # by recipe
  mealie mealplan-text <date> <entryType> <title> [text]
  mealie mealplan-delete <id>
  mealie shopping-list-create <name>
  mealie shopping-list-delete <listId>
  mealie shopping-add <listId> <"free text item">   # parsed via NLP
  mealie parse <"ingredient text">                  # parse, don't save

entryType: breakfast | lunch | dinner | side | snack | drink | dessert
EOF
}

req() {
  local method="$1" path="$2" body="${3:-}"
  local url="${MEALIE_BASE_URL%/}${path}"
  if [[ -n "$body" ]]; then
    curl "${CURL_OPTS[@]}" -sS --fail-with-body \
      -H "Authorization: Bearer $MEALIE_API_KEY" \
      -H "Content-Type: application/json" \
      -X "$method" -d "$body" "$url"
  else
    curl "${CURL_OPTS[@]}" -sS --fail-with-body \
      -H "Authorization: Bearer $MEALIE_API_KEY" \
      -X "$method" "$url"
  fi
}

pretty() {
  if command -v jq >/dev/null 2>&1; then jq .; else python3 -m json.tool; fi
}

uri() { printf %s "$1" | jq -sRr @uri; }
today() { date -u +%F; }

cmd="${1:-}"; shift || true
case "$cmd" in
  ""|-h|--help|help) usage; exit 0;;

  raw)
    [[ $# -ge 2 ]] || { echo "mealie raw <method> <path> [body]" >&2; exit 1; }
    req "$1" "$2" "${3:-}"; echo;;
  GET|POST|PUT|PATCH|DELETE)
    [[ $# -ge 1 ]] || { echo "mealie $cmd <path> [body]" >&2; exit 1; }
    req "$cmd" "$1" "${2:-}" | pretty;;

  self)
    req GET "/api/users/self" | pretty;;

  recipes)
    q="${1:-}"; page="${2:-1}"; size="${3:-25}"
    if [[ -n "$q" ]]; then
      req GET "/api/recipes?search=$(uri "$q")&page=$page&perPage=$size" | pretty
    else
      req GET "/api/recipes?page=$page&perPage=$size" | pretty
    fi;;
  recipe)
    [[ $# -eq 1 ]] || { echo "mealie recipe <slug>" >&2; exit 1; }
    req GET "/api/recipes/$1" | pretty;;
  suggestions)
    foods="${1:-}"; limit="${2:-10}"
    qs="limit=$limit"
    [[ -n "$foods" ]] && qs="$qs&foods=$(uri "$foods")"
    req GET "/api/recipes/suggestions?$qs" | pretty;;

  mealplans)
    start="${1:-$(today)}"; end="${2:-$start}"
    req GET "/api/households/mealplans?start_date=$start&end_date=$end&perPage=100" | pretty;;
  mealplan-add)
    [[ $# -eq 3 ]] || { echo "mealie mealplan-add <date> <entryType> <recipeId>" >&2; exit 1; }
    req POST "/api/households/mealplans" \
      "$(jq -n --arg d "$1" --arg t "$2" --arg r "$3" '{date:$d,entryType:$t,recipeId:$r}')" | pretty;;
  mealplan-text)
    [[ $# -ge 3 ]] || { echo "mealie mealplan-text <date> <entryType> <title> [text]" >&2; exit 1; }
    req POST "/api/households/mealplans" \
      "$(jq -n --arg d "$1" --arg t "$2" --arg ti "$3" --arg tx "${4:-}" \
            '{date:$d,entryType:$t,title:$ti,text:$tx}')" | pretty;;
  mealplan-delete)
    [[ $# -eq 1 ]] || { echo "mealie mealplan-delete <id>" >&2; exit 1; }
    req DELETE "/api/households/mealplans/$1" | pretty;;

  shopping-lists)
    req GET "/api/households/shopping/lists?perPage=50" | pretty;;
  shopping-list)
    [[ $# -eq 1 ]] || { echo "mealie shopping-list <listId>" >&2; exit 1; }
    req GET "/api/households/shopping/items?queryFilter=$(uri "shoppingListId=$1")&perPage=200" | pretty;;
  shopping-list-create)
    [[ $# -eq 1 ]] || { echo "mealie shopping-list-create <name>" >&2; exit 1; }
    req POST "/api/households/shopping/lists" \
      "$(jq -n --arg n "$1" '{name:$n}')" | pretty;;
  shopping-list-delete)
    [[ $# -eq 1 ]] || { echo "mealie shopping-list-delete <listId>" >&2; exit 1; }
    req DELETE "/api/households/shopping/lists/$1" | pretty;;
  shopping-add)
    [[ $# -eq 2 ]] || { echo "mealie shopping-add <listId> <text>" >&2; exit 1; }
    req POST "/api/households/shopping/items" \
      "$(jq -n --arg l "$1" --arg d "$2" '{shoppingListId:$l,note:$d,display:$d,quantity:1}')" | pretty;;

  cookbooks)
    req GET "/api/households/cookbooks?perPage=50" | pretty;;
  foods)
    q="${1:-}"; size="${2:-25}"
    if [[ -n "$q" ]]; then
      req GET "/api/foods?search=$(uri "$q")&perPage=$size" | pretty
    else
      req GET "/api/foods?perPage=$size" | pretty
    fi;;
  units)
    q="${1:-}"; size="${2:-50}"
    if [[ -n "$q" ]]; then
      req GET "/api/units?search=$(uri "$q")&perPage=$size" | pretty
    else
      req GET "/api/units?perPage=$size" | pretty
    fi;;
  categories) req GET "/api/organizers/categories?perPage=100" | pretty;;
  tags)       req GET "/api/organizers/tags?perPage=100" | pretty;;

  scrape-url)
    [[ $# -eq 1 ]] || { echo "mealie scrape-url <url>" >&2; exit 1; }
    req POST "/api/recipes/create/url" \
      "$(jq -n --arg u "$1" '{url:$u,includeTags:true,includeCategories:true}')" | pretty;;
  parse)
    [[ $# -eq 1 ]] || { echo "mealie parse <text>" >&2; exit 1; }
    req POST "/api/parser/ingredient" \
      "$(jq -n --arg i "$1" '{parser:"nlp",ingredient:$i}')" | pretty;;

  *) echo "mealie: unknown command '$cmd'" >&2; usage >&2; exit 1;;
esac
