# Local dev defaults — matches docker-compose.yml credentials
# Do NOT use these values in production.

# PostgreSQL connection URL (VectorChord + pgvector)
DATABASE_URL=postgres://rag:rag@localhost:6000/rag

# S3-compatible storage (MinIO for local dev)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=rag-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Database connection pool
DB_MAX_CONNECTIONS=5

# Embedding model (FastEmbed / ONNX)
EMBEDDING_MODEL=nomic-embed-text-v1.5

# Chunking
CHUNK_SIZE=2048
CHUNK_OVERLAP=200
MIN_CHUNK_SIZE=50

# Deduplication
DEDUP_THRESHOLD=0.97
DEDUP_CANDIDATE_FACTOR=3

# --- HTTP server (serve-http subcommand only) ---

# Google OAuth2 credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAuth redirect URI (must match Google Cloud Console config)
OAUTH_REDIRECT_URI=http://localhost:8080/auth/callback

# HTTP bind address
HTTP_BIND=0.0.0.0:8080

# API key LRU cache TTL in seconds
API_KEY_CACHE_TTL_SECS=60

# MCP session idle timeout in seconds
MCP_SESSION_IDLE_SECS=1800

# First admin: this email is auto-promoted on first OAuth login
FIRST_ADMIN_EMAIL=admin@example.com

# Note: `cargo sqlx prepare` is not needed for this project.
# All queries use runtime `query_as` (not the compile-time `query_as!` macro),
# so there is no offline query-checking step required.
