# Local dev defaults — matches docker-compose.yml credentials
# Do NOT use these values in production.

# PostgreSQL connection URL (pgvector-enabled)
DATABASE_URL=postgres://rag:rag@localhost:5432/rag

# S3-compatible storage (MinIO for local dev)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=rag-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Database connection pool
DB_MAX_CONNECTIONS=5

# Embedding model (FastEmbed / ONNX)
EMBEDDING_MODEL=nomic-embed-text-v2-moe

# Note: `cargo sqlx prepare` is not needed for this project.
# All queries use runtime `query_as` (not the compile-time `query_as!` macro),
# so there is no offline query-checking step required.
